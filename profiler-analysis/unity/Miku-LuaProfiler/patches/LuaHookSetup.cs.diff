+        public static void DoRefLuaFun(IntPtr L, string funName, int reference)
+        {
+            int moreOldTop = LuaDLL.lua_gettop(L);
+            LuaDLL.lua_getref(L, reference);
+
+            if (LuaDLL.lua_isfunction(L, -1) || LuaDLL.lua_istable(L, -1))
